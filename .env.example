# App Configuration
ENV=development
LOG_LEVEL=INFO

# LLM Provider: "stub" (in-memory, no network) or "ollama"
LLM_PROVIDER=stub

# Ollama LLM Configuration (native /api/chat endpoint; local or Cloud)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
# Required for Ollama Cloud
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=120

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
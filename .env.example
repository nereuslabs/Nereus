# App Configuration
ENV=development
LOG_LEVEL=INFO

# LLM Provider:
#   "stub"      — in-memory, no network (default, CI/offline-safe)
#   "openrouter" — OpenRouter aggregator (chat + embeddings); needs OPENROUTER_API_KEY
#   "ollama"    — legacy local/Cloud Ollama via /api/chat
LLM_PROVIDER=stub

# Ollama LLM Configuration (native /api/chat endpoint; local or Cloud)
# Cloud model names do NOT carry a "-cloud" suffix (e.g. use "gemma4:31b"
# or "gpt-oss:20b", NOT "gemma4:31b-cloud" which is retired).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b
# Required for Ollama Cloud
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=120
# Optional generation overrides (fall back to role defaults in llm/params.py)
OLLAMA_TEMPERATURE=
OLLAMA_MAX_TOKENS=

# OpenRouter Configuration
# Get a free API key at https://openrouter.ai/keys . The special model
# "openrouter/free" routes to an available free-tier model at request time
# (the actual model is echoed back in responses as `model`).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT=60
OPENROUTER_HTTP_REFERER=              # optional, for leaderboard attribution
OPENROUTER_TITLE=Nereus               # optional, shown on the OpenRouter dashboard
OPENROUTER_API_KEY=

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# RAG / embeddings
#   "stub"          — deterministic SHA-256 vectors (offline, default)
#   "sentence_transformers"
#   "ollama"        — legacy local Ollama embedding server
#   "openrouter"    — OpenRouter embeddings endpoint (needs OPENROUTER_API_KEY)
EMBEDDING_PROVIDER=stub
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_EMBED_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# Only used when EMBEDDING_PROVIDER=openrouter (cheap credits model)
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# Live-LLM test gate: set to 1 with LLM_PROVIDER=openrouter (and
# OPENROUTER_API_KEY) or LLM_PROVIDER=ollama to run the live integration
# tests under tests/integration/.
NEREUS_RUN_LIVE=0
# App Configuration
ENV=development
LOG_LEVEL=INFO

# LLM Provider: "stub" (in-memory, no network) or "ollama"
LLM_PROVIDER=stub

# Ollama LLM Configuration (native /api/chat endpoint; local or Cloud)
# Cloud model names do NOT carry a "-cloud" suffix (e.g. use "gemma4:31b"
# or "gpt-oss:20b", NOT "gemma4:31b-cloud" which is retired).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b
# Required for Ollama Cloud
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=120
# Optional generation overrides (fall back to role defaults in llm/params.py)
OLLAMA_TEMPERATURE=
OLLAMA_MAX_TOKENS=

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Session context window (approx max tokens for the messages history)
CONTEXT_MAX_TOKENS=8000

# Live-LLM test gate: set to 1 together with LLM_PROVIDER=ollama to run
# tests/integration/test_live_ollama.py against a real Ollama instance.
NEREUS_RUN_LIVE=0